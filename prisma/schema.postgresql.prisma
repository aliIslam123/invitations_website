generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── USER / AUTH ──────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          String    @default("ADMIN")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  invitations WeddingInvitation[]
  sessions    Session[]
  accounts    Account[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

// ─── WEDDING INVITATION ───────────────────────────────────────────────────────

model WeddingInvitation {
  id        String   @id @default(cuid())
  slug      String   @unique
  status    String   @default("DRAFT")
  userId    String

  title       String  @default("")
  language    String  @default("ar")
  direction   String  @default("rtl")

  coverEnabled        Boolean @default(true)
  coverType           String  @default("elegant")
  coverImage          String?
  coverOverlayColor   String  @default("#332A25")
  coverOverlayOpacity Float   @default(0.5)
  coverMonogram       String?

  themeId         String  @default("royal-champagne")
  themeCustom     String?

  animationPreset String  @default("elegant")

  seoTitle        String?
  seoDescription  String?
  seoImage        String?
  whatsappMessage String?

  musicEnabled    Boolean @default(false)
  musicUrl        String?
  musicTitle      String?
  musicAutoplay   Boolean @default(false)
  musicPosition   String  @default("bottom-right")

  rsvpEnabled        Boolean   @default(false)
  rsvpDeadline       DateTime?
  rsvpMaxGuests      Int?
  rsvpAllowPlusOne   Boolean   @default(true)
  rsvpRequireContact Boolean   @default(false)
  rsvpConfirmMsg     String?
  rsvpDeclineMsg     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  couple        CoupleInformation?
  events        WeddingEvent[]
  gallery       GalleryImage[]
  sections      InvitationSection[]
  rsvpResponses RSVPResponse[]
  mediaAssets   MediaAsset[]
  timeline      TimelineItem[]

  @@index([slug])
  @@index([userId])
  @@index([status])
  @@map("wedding_invitations")
}

// ─── COUPLE INFORMATION ───────────────────────────────────────────────────────

model CoupleInformation {
  id           String @id @default(cuid())
  invitationId String @unique

  brideFirstName   String  @default("")
  brideLastName    String  @default("")
  brideFullName    String  @default("")
  brideFather      String?
  brideMother      String?
  brideFamily      String?
  brideBio         String?
  bridePhoto       String?

  groomFirstName   String  @default("")
  groomLastName    String  @default("")
  groomFullName    String  @default("")
  groomFather      String?
  groomMother      String?
  groomFamily      String?
  groomBio         String?
  groomPhoto       String?

  couplePhoto      String?
  monogram         String?
  weddingDate      DateTime?
  weddingTime      String?
  timezone         String  @default("Asia/Riyadh")

  messageHeading    String?
  messageBody       String?
  messageFontFamily String?

  heroLayout        String  @default("cinematic")
  heroImage         String?
  heroImageMobile   String?
  heroVideo         String?

  invitationText    String?
  invitationSubtext String?

  familyNamesEnabled Boolean @default(false)
  familyNamesContent String?

  dressCodeEnabled Boolean @default(false)
  dressCodeContent String?

  giftInfoEnabled  Boolean @default(false)
  giftInfoContent  String?

  contactEnabled   Boolean @default(false)
  contactPhone     String?
  contactWhatsapp  String?
  contactEmail     String?

  socialEnabled    Boolean @default(false)
  socialLinks      String?

  customSections   String?
  wishesEnabled    Boolean @default(false)

  postEventEnabled Boolean @default(false)
  postEventMessage String?
  postEventImage   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invitation WeddingInvitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  @@map("couple_information")
}

// ─── WEDDING EVENTS ───────────────────────────────────────────────────────────

model WeddingEvent {
  id           String @id @default(cuid())
  invitationId String

  title        String
  date         DateTime
  startTime    String?
  endTime      String?
  timezone     String  @default("Asia/Riyadh")
  venueName    String?
  address      String?
  mapsUrl      String?
  latitude     Float?
  longitude    Float?
  venueImage   String?
  description  String?
  dressCode    String?
  notes        String?
  displayOrder Int     @default(0)
  isVisible    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invitation WeddingInvitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  @@index([invitationId])
  @@map("wedding_events")
}

// ─── GALLERY ──────────────────────────────────────────────────────────────────

model GalleryImage {
  id           String @id @default(cuid())
  invitationId String

  url          String
  thumbnailUrl String?
  caption      String?
  altText      String?
  displayOrder Int     @default(0)
  isVisible    Boolean @default(true)
  width        Int?
  height       Int?
  fileSize     Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invitation WeddingInvitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  @@index([invitationId])
  @@map("gallery_images")
}

// ─── INVITATION SECTIONS ──────────────────────────────────────────────────────

model InvitationSection {
  id           String @id @default(cuid())
  invitationId String

  sectionKey   String
  displayOrder Int     @default(0)
  isVisible    Boolean @default(true)
  layout       String?
  settings     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invitation WeddingInvitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  @@unique([invitationId, sectionKey])
  @@index([invitationId])
  @@map("invitation_sections")
}

// ─── TIMELINE ─────────────────────────────────────────────────────────────────

model TimelineItem {
  id           String @id @default(cuid())
  invitationId String

  time         String?
  title        String
  description  String?
  icon         String?
  displayOrder Int     @default(0)
  isVisible    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invitation WeddingInvitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  @@index([invitationId])
  @@map("timeline_items")
}

// ─── RSVP ─────────────────────────────────────────────────────────────────────

model RSVPResponse {
  id           String @id @default(cuid())
  invitationId String

  guestName    String
  attendance   String
  guestCount   Int     @default(1)
  phone        String?
  email        String?
  message      String?
  dietary      String?
  ipAddress    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invitation WeddingInvitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  @@index([invitationId])
  @@map("rsvp_responses")
}

// ─── MEDIA ASSETS ─────────────────────────────────────────────────────────────

model MediaAsset {
  id           String @id @default(cuid())
  invitationId String?

  filename     String
  originalName String
  mimeType     String
  fileSize     Int
  url          String
  storageKey   String  @unique
  mediaType    String
  width        Int?
  height       Int?
  duration     Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invitation WeddingInvitation? @relation(fields: [invitationId], references: [id], onDelete: SetNull)

  @@index([invitationId])
  @@map("media_assets")
}
